rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: get the caller's user doc
    function callerClientId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId;
    }

    function safeUserWritableKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'photoURL',
        'lastLoginAt',
        'updatedAt',
        'createdAt',
        'dashboardTitle',
        'dashboardDescription'
      ];
    }

    function validOwnUserProfile(userId) {
      return request.auth != null
             && request.auth.uid == userId
             && request.resource.data.uid == userId
             && request.resource.data.email == request.auth.token.email;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if validOwnUserProfile(userId)
                    && request.resource.data.keys().hasOnly(safeUserWritableKeys());
      allow update: if validOwnUserProfile(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(safeUserWritableKeys())
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read: if request.auth != null && callerClientId() == clientId;
      allow write: if false;
    }

    match /clients/{clientId}/members/{memberId} {
      allow read: if request.auth != null && request.auth.uid == memberId;
      allow write: if false;
    }

    // Source of truth for pipeline behavior — server-owned, client read-only.
    match /client_configs/{clientId} {
      allow read: if request.auth != null && callerClientId() == clientId;
      allow write: if false;
    }

    // Normalized dashboard state — the only collection dashboard renders from.
    match /dashboard_state/{clientId} {
      allow read: if request.auth != null && callerClientId() == clientId;
      allow write: if false;
    }

    // brief_runs is admin/server-only — no direct client reads.
    match /brief_runs/{runId} {
      allow read, write: if false;
    }

    // Per-client brief_runs mirror. The run doc itself stays server-owned
    // (allow read: false), but the events subcollection is readable by the
    // signed-in user bound to that client so the dashboard terminal can
    // stream real-time pipeline progress via onSnapshot.
    match /clients/{clientId}/brief_runs/{runId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read:  if request.auth != null && callerClientId() == clientId;
        allow write: if false;
      }
    }

    // Lead Gen pipeline — two doc populations live here:
    //   1. Operator-owned prospect docs (any placeId not starting with "client:")
    //      — server-only via Admin SDK; normal client users cannot read these.
    //   2. Per-client synthetic docs (placeId == "client:{clientId}") seeded by
    //      /api/leadgen/seed-client-prospect — readable/updatable only by the
    //      user bound to that clientId.
    // All writes go through the Admin SDK in /api/leadgen/* routes which bypass
    // these rules. Client-side onSnapshot reads for the dashboard use these rules.
    match /leadgen_prospects/{placeId} {
      allow read: if request.auth != null
                  && placeId.matches('client:.*')
                  && resource.data.clientId == callerClientId();
      allow update: if request.auth != null
                    && placeId.matches('client:.*')
                    && resource.data.clientId == callerClientId()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starred', 'generation']);
      allow create, delete: if false;
    }

    // leadgen_configs is operator/admin-only — all access via Admin SDK server-side.
    match /leadgen_configs/{configId} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
