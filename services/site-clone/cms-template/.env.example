# Local file DB (default — works offline, no account needed):
DATABASE_URI=file:./{{PROJECT}}.db

# Hosted Turso (cloud sync + backups):
#   turso db create {{PROJECT}}
#   turso db show {{PROJECT}} --url        → DATABASE_URI=libsql://…
#   turso db tokens create {{PROJECT}}     → DATABASE_AUTH_TOKEN=…
# then re-run: npm run seed
# DATABASE_URI=libsql://{{PROJECT}}-<org>.turso.io
# DATABASE_AUTH_TOKEN=

PAYLOAD_SECRET={{PAYLOAD_SECRET}}
