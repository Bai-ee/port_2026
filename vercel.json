{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "app/api/**/*": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/worker/pre-digest-video",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/worker/pre-digest-refresh",
      "schedule": "35 12 * * *"
    },
    {
      "path": "/api/admin/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/worker/render-studio",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/worker/media-reconcile",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/admin/daily-digest?mode=approval-rollup",
      "schedule": "20 13 * * *"
    },
    {
      "path": "/api/social-posting?action=process-due",
      "schedule": "40 13 * * *"
    }
  ]
}
