{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "app/api/**/*": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/worker/pre-digest-video",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/worker/pre-digest-refresh?phase=modules",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/worker/pre-digest-refresh?phase=signals",
      "schedule": "20 12 * * *"
    },
    {
      "path": "/api/worker/pre-digest-refresh?phase=analysis",
      "schedule": "40 12 * * *"
    },
    {
      "path": "/api/admin/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/worker/render-studio",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/worker/media-reconcile",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/social-posting?action=process-due",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/worker/telegram-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/worker/daily-loop",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/worker/instagram-token-refresh",
      "schedule": "45 10 * * *"
    }
  ]
}
