# Server-side Firebase Admin credentials for Vercel API functions
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=your_project_storage_bucket

# Worker auth — required for automated worker invocations (cron/external triggers)
# If unset, /api/worker/run-brief falls back to Firebase admin token auth only.
WORKER_SECRET=your_worker_secret_here
# Required for Vercel Cron endpoints. Vercel sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=your_cron_secret_here

# Managed Browserless screenshot capture for intake artifacts
BROWSERLESS_TOKEN=your_browserless_token_here
# Optional override. Defaults to Browserless production REST base URL.
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io

# Scout / Not The Rug brief feature
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# KIMI fallback — used automatically when Anthropic credit balance is exhausted
KIMI_API_KEY=your_kimi_api_key_here
NWS_USER_AGENT=NotTheRugScout/1.0 (your-email@example.com)
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_access_token_here
NOT_THE_RUG_INSTAGRAM_USER_ID=your_instagram_business_account_id_here
REDDIT_CLIENT_ID=your_reddit_app_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_app_client_secret_here
REDDIT_USER_AGENT=NotTheRugScout/1.0 (your-email@example.com)

# Google PageSpeed Insights API key (free, 25k/day)
# Without key: anonymous pool (~1 req/sec). Sufficient for dev, set for prod.
# Get one at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=your_pagespeed_api_key_here
# Intake runner reads this as enabled unless explicitly set to 0.
PAGESPEED_ENABLED=1

# Analyzer skill fanout is off by default unless this is set in the server env.
SCOUT_ANALYZER_SKILLS_ENABLED=1
# AI SEO audit is enabled by default; set to 0 to disable.
AI_SEO_AUDIT_ENABLED=1

# Lead generation / prospecting feature keys
SERPAPI_KEY=your_serpapi_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LAZYWEB_TOKEN=your_lazyweb_token_here

# Lead generation email sending
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token

# Vercel API access for deploy previews/custom brief publishing/daily digest metrics
VERCEL_API_TOKEN=your_vercel_api_token_here
# Optional fallback name supported by custom brief publishing.
VERCEL_AUTH_TOKEN=your_vercel_api_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here
VERCEL_TEAM_SLUG=your_vercel_team_slug_here

# Daily digest email, analytics, and calendar
RESEND_API_KEY=your_resend_api_key_here
DIGEST_EMAIL=you@example.com
DIGEST_FROM="HitLoop Daily <digest@hitloop.agency>"
DIGEST_CALENDAR_ID=you@example.com
DIGEST_TIMEZONE=America/Chicago
GA4_PROPERTY_ID=your_ga4_property_id_here

# Optional agent-ready enrichment
CLOUDFLARE_RADAR_API_TOKEN=your_cloudflare_radar_token_here

# Optional social posting / X API integration
SOCIAL_POSTING_CRON_SECRET=your_social_posting_cron_secret_here
TWITTER_API_KEY=your_x_api_key_here
TWITTER_API_SECRET=your_x_api_secret_here
TWITTER_ACCESS_TOKEN=your_x_access_token_here
TWITTER_ACCESS_SECRET=your_x_access_secret_here

# Local Python binary for device mockup generation.
# PYTHON_VENV_DIR: repo-relative venv dir for auto-detection (e.g. .venv). Set in .env.local.
PYTHON_VENV_DIR=
# PYTHON_BIN: absolute path override — wins over PYTHON_VENV_DIR. Falls back to system python3.
PYTHON_BIN=



